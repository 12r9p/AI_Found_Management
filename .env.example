# ===== 共通 =====
# 認証は Cloudflare Zero Trust（Access）で行う前提。
# ローカル開発では ACCESS を無効化し、スタッフ想定で全操作を許可する。

# ===== API (apps/api) =====
# DB は D1 + Vectorize（wrangler.toml の [[d1_databases]] / [[vectorize]] バインディング経由）。
# 接続文字列は不要。バインディングが無い環境（素の `bun run dev:api` など）では
# 自動的に「インメモリストア」で起動する（外部依存ゼロでデモ可能）。

# AI プロバイダ（GPT 5.6 Luna 相当）。未設定なら決定論的モックで動作する。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_VISION_MODEL=gpt-5.6-luna
AI_EMBED_MODEL=text-embedding-3-small
AI_EFFORT=low
EMBED_DIM=1536

# 突き合わせ（マッチング）のコサイン類似度しきい値（0-1）。
MATCH_THRESHOLD=0.5
# 通常検索で表示する最低類似度。未設定時は MATCH_THRESHOLD と同じ。
SEARCH_THRESHOLD=0.5

# R2（画像ストレージ）。ローカルでは Worker バインディング or ディスクにフォールバック。
# wrangler.toml の r2_buckets を参照。ローカル dev は .data/uploads/ に保存。

# CORS 許可オリジン（フロントの URL）。
WEB_ORIGIN=http://localhost:3000

# ===== Web (apps/web) =====
NEXT_PUBLIC_API_BASE=http://localhost:8787

# ===== Cloudflare Access (Zero Trust) 検証 =====
# 両方設定すると API 側でも Access JWT を検証する（Worker URL 直叩き対策）。
# ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# ACCESS_AUD=<Access アプリの Application Audience (AUD) タグ>
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
