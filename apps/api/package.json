{
  "name": "@found/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "cf-dev": "wrangler dev --config wrangler.toml --config ../images/wrangler.toml",
    "seed": "bun run src/scripts/seed.ts",
    "migrate": "bun run src/scripts/migrate.ts",
    "migrate:local": "wrangler d1 migrations apply found-db --local",
    "migrate:remote": "wrangler d1 migrations apply found-db --remote",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.1",
    "@elysiajs/swagger": "^1.1.6",
    "elysia": "^1.1.26"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/bun": "^1.1.14",
    "typescript": "6.0.3",
    "wrangler": "4.118.0"
  }
}
