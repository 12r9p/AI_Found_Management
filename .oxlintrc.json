{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["apps/web/next-env.d.ts", "apps/images/worker-configuration.d.ts"],
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "nextjs", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // 認証付き画像はNext.jsの画像最適化経由では取得できないため、ネイティブimg要素を許可する。
    "nextjs/no-img-element": "off"
  },
  "settings": {
    "next": {
      "rootDir": "apps/web"
    }
  }
}
